# Bharat Panchyt Backend Environment Variables (Production / Local)

# Project
PROJECT_NAME="Bharat Panchyt"
API_V1_STR="/api/v1"

# Security (Change in production to a long random secret)
SECRET_KEY="bharatpanchyt-sih-2026-jharkhand-secure-secret-key-32chars"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Database:
# For SQLite (default demo): sqlite:///./bharatpanchyt.db
# For PostgreSQL (e.g. Render/Supabase): postgresql://user:password@hostname:5432/dbname
DATABASE_URL="sqlite:///./bharatpanchyt.db"

# Persistent File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""
BACKEND_URL=""

# Gemini AI (Optional - platform has deterministic rule-based fallback if absent)
GEMINI_API_KEY=""

# SMS Gateway (Optional - platform prints OTP to console if absent)
SMS_API_KEY=""
SMS_SENDER_ID="BHRTPN"
